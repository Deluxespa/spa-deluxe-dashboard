# Kopiere diese Datei nach ".env" und trage echte Werte ein.
# ".env" wird von .gitignore ausgeschlossen und darf NIE committet werden.

# --- Dashboard-Verschlüsselung (Pflicht) ---
# Passwort, mit dem dashboard/index.html client-seitig entschlüsselt wird.
DASHBOARD_PASSWORD=change-me

# --- Google Sheets (für Deals/Umsatz-Daten, befüllt per Zoho-Automatisierung/Zapier/Make) ---
# Siehe lib/gsheet_processing.py. GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON = kompletter
# Inhalt der Service-Account-JSON-Key-Datei (Google Cloud Console -> IAM & Admin ->
# Dienstkonten -> Key erstellen), als EINE Zeile/String. Das Ziel-Sheet muss mit der
# client_email des Service-Accounts geteilt werden (Leserechte reichen).
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
# GOOGLE_SHEETS_SPREADSHEET_ID: aus der Sheet-URL
# (https://docs.google.com/spreadsheets/d/<DIESE_ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Optional:
# GOOGLE_SHEETS_RANGE=Deals!A:Z
# WON_DEAL_STAGES=Closed Won

# --- Google Ads ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Meta Ads ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- Google Search Console ---
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=

# --- Sistrix (SEO-Sichtbarkeit) ---
SISTRIX_API_KEY=
SISTRIX_DOMAIN=

# --- Notion (Tasks/Learnings/Content-Plan/Anomalien) ---
NOTION_TOKEN=
NOTION_DB_WEEKLY_NUMBERS=
NOTION_DB_TASKS=
NOTION_DB_LEARNINGS=
NOTION_DB_CONTENT_PLAN=
NOTION_DB_ANOMALIES=

# --- Anthropic (für KI-gestützte Analyse-Jobs) ---
ANTHROPIC_API_KEY=

# --- GitHub Pages Deploy (verschlüsseltes Dashboard veröffentlichen) ---
# DASHBOARD_REPO: "owner/repo" des Ziel-Repos, das per GitHub Pages ausliefert.
# GH_PAGES_TOKEN: Personal Access Token mit "repo"-Scope für DASHBOARD_REPO.
DASHBOARD_REPO=
GH_PAGES_TOKEN=
